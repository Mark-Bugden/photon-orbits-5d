    x = -a - b**2 + sqrt(a**2 - 2*a - b**2 + 1) + 1    Phi = -sqrt(a**2 - 2*a - b**2 + 1) - 1
    x = -a - b**2 - sqrt(a**2 - 2*a - b**2 + 1) + 1    Phi = sqrt(a**2 - 2*a - b**2 + 1) - 1
    x = a - b**2 + sqrt(a**2 + 2*a - b**2 + 1) + 1    Phi = sqrt(a**2 + 2*a - b**2 + 1) + 1
