xi = d_t - [a/(x_+ + a^2)] d_phi - [b/(x_+ + b^2)] d_psi : g(xi,xi)|_H = [-0.e-125, -0.e-127, -0.e-128]
frame dragging omega_phi = -g_tphi/g_phiphi (theta=pi/2, b=0): -a*mu/(a**2*mu + a**2*x + x**2)

